# {{ ansible_managed }} - Variables del microservicio de firma. Permisos 0640 root:{{ firma_group }}.
FIRMA_NODE_ID={{ inventory_hostname }}
FIRMA_NODE_LOCATION={{ node_location | default('') }}
FIRMA_BIND_HOST={{ api_bind_address }}
FIRMA_BIND_PORT={{ api_port }}
FIRMA_TLS_CERT={{ firma_conf_dir }}/tls/node.crt
FIRMA_TLS_KEY={{ firma_conf_dir }}/tls/node.key
FIRMA_API_KEY={{ api_key }}
FIRMA_MAX_PDF_MB={{ api_max_pdf_mb }}

FIRMA_PKCS11_MODULE={{ pkcs11_module_path }}
FIRMA_PKCS11_TOKEN_LABEL={{ pkcs11_token_label }}
FIRMA_PKCS11_CERT_LABEL={{ pkcs11_cert_label }}
FIRMA_PKCS11_KEY_LABEL={{ pkcs11_key_label }}
FIRMA_PKCS11_PIN={{ pkcs11_user_pin }}
FIRMA_TOKEN_DEVICE=/dev/token-f2

FIRMA_SIG_REASON={{ sig_reason_default }}
FIRMA_SIG_LOCATION={{ sig_location_default }}
FIRMA_SIG_CONTACT={{ sig_contact_default }}
FIRMA_TSA_URL={{ tsa_url }}
FIRMA_EMBED_VALIDATION_INFO={{ 'true' if embed_validation_info else 'false' }}

FIRMA_AUDIT_LOG={{ firma_log_dir }}/audit.jsonl
FIRMA_TELEMETRY_ENDPOINT={{ telemetry_endpoint }}
FIRMA_WATCHDOG_SEC={{ api_watchdog_sec }}
FIRMA_LOG_LEVEL=INFO
